# ============================================================
# TripMate AI — Environment Variables
# Copy this file to .env and fill in your real keys.
# ============================================================

# Required — free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Optional — llama-3.3-70b-versatile was retired on Groq (Aug 2026)
GROQ_MODEL=openai/gpt-oss-120b

# Required — free at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key

# Required — free at https://aviationstack.com
# Either name works:
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
# AVIATION_STACK_API_KEY=your_aviationstack_api_key

# Optional — free at https://openweathermap.org/api
# Needed for the custom weather MCP server
OPENWEATHER_API_KEY=your_openweather_api_key

# ------------------------------------------------------------
# Memory / Checkpoint
# ------------------------------------------------------------
# Option A (recommended for CV demo without installing Postgres):
USE_MEMORY_CHECKPOINT=true

# Option B (local PostgreSQL — create DB first):
# USE_MEMORY_CHECKPOINT=false
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/langgraph_memory_demo

# Option C (cloud Postgres e.g. Render — SSL is auto-added):
# USE_MEMORY_CHECKPOINT=false
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
